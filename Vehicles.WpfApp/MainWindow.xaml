<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vehicles.WpfApp"
        mc:Ignorable="d"
        Title="Vehicles" Height="415" Width="545" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="203*"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Margin="82,10,0,0" TextWrapping="Wrap" Text="Vehicles" VerticalAlignment="Top" FontSize="24" HorizontalAlignment="Left" Height="32" Width="398" Grid.ColumnSpan="2" FontWeight="Bold">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <Label x:Name="Make" Content="Make:" HorizontalAlignment="Left" Margin="35,59,0,0" VerticalAlignment="Top" Height="26" Width="42">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <TextBox x:Name="MakeBox" HorizontalAlignment="Left" Margin="116,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.482,0.445" TextChanged="MakeBox_TextChanged" Height="18" Background="{x:Null}">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Label Content="Model:" HorizontalAlignment="Left" Margin="281,59,0,0" VerticalAlignment="Top" Height="26" Width="47" Background="{x:Null}" RenderTransformOrigin="-0.429,0.642" BorderBrush="Black">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <TextBox x:Name="ModelBox" HorizontalAlignment="Left" Margin="351,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged" Height="18" Background="{x:Null}" Grid.ColumnSpan="2">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Label Content="Vehicle type:" HorizontalAlignment="Left" Margin="35,117,0,0" VerticalAlignment="Top" Height="26" Width="76">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <ComboBox x:Name="VehicleTypeBox" HorizontalAlignment="Left" Margin="116,121,0,0" VerticalAlignment="Top" Width="120" Height="22" BorderBrush="#FF121111">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                    <GradientStop Color="#FF313131" Offset="0.197"/>
                    <GradientStop Color="#FF414141" Offset="0.267"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Button x:Name="AddVehicleButton" Content="Add Vehicle" HorizontalAlignment="Left" Margin="292,122,0,0" VerticalAlignment="Top" Click="Button_Click" Height="27" Width="82" BorderBrush="{x:Null}" Background="#FFB0C6EA">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <DataGrid x:Name="VehiclesGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="41,168,0,109" SelectionChanged="VehiclesGrid_SelectionChanged" AutoGenerateColumns="False" HorizontalAlignment="Left" Width="182" BorderBrush="White" Foreground="#FF100F0F" BorderThickness="0,0,0,0">
            <DataGrid.Effect>
                <DropShadowEffect/>
            </DataGrid.Effect>
            <DataGrid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="0.22"/>
                    <GradientStop Color="#FFC4C4C4" Offset="0.28"/>
                    <GradientStop Color="WhiteSmoke" Offset="0.44"/>
                </LinearGradientBrush>
            </DataGrid.Background>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Make" Binding="{Binding Make}"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
                <DataGridTextColumn Header="Odometer(Km)" Binding="{Binding Odometer}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Distance (km):" HorizontalAlignment="Left" Margin="36,312,0,0" VerticalAlignment="Top" Height="26" Width="86">
            <Label.Effect>
                <DropShadowEffect/>
            </Label.Effect>
        </Label>
        <TextBox x:Name="DistanceBox" HorizontalAlignment="Left" Margin="127,314,0,0" TextWrapping="Wrap" Text="&#xD;&#xA;" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged_1" Height="17" BorderBrush="#FFABADB3" Background="{x:Null}">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button x:Name="DriveButton" Content="Drive" HorizontalAlignment="Left" Margin="37,314,0,0" VerticalAlignment="Top" Click="Button_Click_1" Grid.Column="1" Height="75" Width="60" Background="#FF9EA0F7">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="SwimButton" Content="Swim" HorizontalAlignment="Left" Margin="329,313,0,0" VerticalAlignment="Top" Click="SwimButton_Click" Height="75" Width="59" Background="#FFA4A6F5">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <ListBox x:Name="LogListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="279,183,30,117" Grid.ColumnSpan="2" SelectionChanged="LogListBox_SelectionChanged">
            <ListBox.Effect>
                <DropShadowEffect/>
            </ListBox.Effect>
        </ListBox>
        <Button x:Name="DeleteVehicleButton" Content="Delete vehicle" HorizontalAlignment="Left" Margin="283,368,0,0" VerticalAlignment="Top" Click="DeleteVehicleButton_Click" Grid.Column="1" Height="20" Width="0"/>

    </Grid>
</Window>
