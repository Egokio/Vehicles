<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="500" Width="650"
        MinHeight="450" MinWidth="600"
        Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Vehicles"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Add vehicle -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0"
                   Content="Make:"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="MakeBox"
                     Grid.Row="0" Grid.Column="1"
                     Margin="5" Height="25"
                     VerticalContentAlignment="Center"/>

            <Label Grid.Row="0" Grid.Column="2"
                   Content="Model:"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="ModelBox"
                     Grid.Row="0" Grid.Column="3"
                     Margin="5" Height="25"
                     VerticalContentAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0"
                   Content="Vehicle type:"
                   VerticalAlignment="Center"/>

            <ComboBox x:Name="VehicleTypeBox"
                      Grid.Row="1" Grid.Column="1"
                      Margin="5" Height="25"
                      VerticalContentAlignment="Center"/>

            <Button x:Name="AddVehicleButton"
                    Grid.Row="1" Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Content="Add Vehicle"
                    Height="28"
                    Margin="5"
                    Click="Button_Click"
                    Background="#FFB0C6EA"/>
        </Grid>

        <!-- Garages -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Car Garage"
                      Padding="8"
                      FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="CarsListBox"
                             Grid.Row="0"
                             SelectionChanged="CarsListBox_SelectionChanged"
                             FontWeight="Normal"
                             Margin="0,0,0,8"/>

                    <Button x:Name="DeleteCarButton"
                            Grid.Row="1"
                            Content="Remove Car"
                            Height="28"
                            Click="DeleteCarButton_Click"
                            Background="#FFFFD6D6"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Boat Garage"
                      Padding="8"
                      FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="BoatsListBox"
                             Grid.Row="0"
                             SelectionChanged="BoatsListBox_SelectionChanged"
                             FontWeight="Normal"
                             Margin="0,0,0,8"/>

                    <Button x:Name="DeleteBoatButton"
                            Grid.Row="1"
                            Content="Remove Boat"
                            Height="28"
                            Click="DeleteBoatButton_Click"
                            Background="#FFFFD6D6"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Movement controls -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Distance (km):"
                   VerticalAlignment="Center"/>

            <TextBox x:Name="DistanceBox"
                     Grid.Column="1"
                     Height="27"
                     Margin="5"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="DriveButton"
                    Grid.Column="2"
                    Content="Drive"
                    Width="75"
                    Height="30"
                    Margin="5"
                    Click="Button_Click_1"
                    Background="#FF9EA0F7"
                    IsEnabled="False"/>

            <Button x:Name="SwimButton"
                    Grid.Column="3"
                    Content="Swim"
                    Width="75"
                    Height="30"
                    Margin="5"
                    Click="SwimButton_Click"
                    Background="#FFA4A6F5"
                    IsEnabled="False"/>
        </Grid>

        <!-- Activity log -->
        <GroupBox Grid.Row="4"
                  Header="Activity Log"
                  Padding="5"
                  FontWeight="Bold">
            <ListBox x:Name="LogListBox"
                     FontWeight="Normal"/>
        </GroupBox>
    </Grid>
</Window>
